{
  "name": "@daw-engine/core",
  "version": "1.0.0-git",
  "private": true,
  "type": "module",
  "main": "./package-dist/index.js",
  "types": "./package-dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./package-dist/index.d.ts",
      "import": "./package-dist/index.js"
    }
  },
  "files": [
    "package-dist",
    "core/LICENSE",
    "core/README.md"
  ],
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "build": "tsc -p core/tsconfig.build.json",
    "build:package": "pnpm run build && esbuild core/src/index.ts --bundle --format=esm --platform=browser --packages=external --outfile=package-dist/index.js && dts-bundle-generator --no-banner --no-check --project core/tsconfig.json --out-file package-dist/index.d.ts core/src/index.ts",
    "lint": "pnpm run lint:core && pnpm run lint:ui-utils",
    "lint:core": "eslint \"core/src/**/*.ts\"",
    "lint:ui-utils": "eslint \"ui-utils/src/**/*.ts\""
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "lamejs": "^1.2.1",
    "soundtouchjs": "^0.3.0"
  },
  "peerDependenciesMeta": {
    "lamejs": {
      "optional": true
    },
    "soundtouchjs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "dts-bundle-generator": "^9.5.1",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.66.0"
  }
}
